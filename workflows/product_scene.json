{
  "1": {"class_type": "CheckpointLoaderSimple",
        "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
  "2": {"class_type": "LoadImage",
        "inputs": {"image": "placeholder.png"}},
  "3": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "product on a marble kitchen counter, soft window light, professional product photography, photorealistic", "clip": ["1", 1]}},
  "4": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "text, watermark, logo, people, blurry, deformed, extra objects on the product", "clip": ["1", 1]}},
  "5": {"class_type": "InpaintModelConditioning",
        "inputs": {"positive": ["3", 0], "negative": ["4", 0], "vae": ["1", 2], "pixels": ["2", 0], "mask": ["2", 1], "noise_mask": true}},
  "6": {"class_type": "KSampler",
        "inputs": {"model": ["1", 0], "seed": 0, "steps": 30, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras",
                   "positive": ["5", 0], "negative": ["5", 1], "latent_image": ["5", 2], "denoise": 1.0}},
  "7": {"class_type": "VAEDecode",
        "inputs": {"samples": ["6", 0], "vae": ["1", 2]}},
  "8": {"class_type": "SaveImage",
        "inputs": {"images": ["7", 0], "filename_prefix": "comfy_serve/product_scene"}}
}
